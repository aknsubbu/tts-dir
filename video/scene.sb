; What a scene may do while manimgl runs it. See sandbox.py. Later rules win.
(version 1)
(allow default)

; Nothing in or out. LaTeX, ffmpeg and the GPU need none.
(deny network*)

; No asking another app to act for it, which the network rule would not stop.
(deny appleevent-send)

; Write only in the project's build/ folder (renders, the check's report, LaTeX's working
; files, its own temporary folder) and the cache kept for scenes. Not the project's own
; script, scenes or notes, and not the caches other programs keep in the home folder.
; The system temporary folders stay open until probing shows exactly what the GPU writes there.
(deny file-write*)
(allow file-write*
  (subpath (param "BUILD"))
  (subpath (param "CACHE"))
  (subpath "/private/tmp")
  (subpath "/private/var/folders")
  (subpath "/dev"))
