# Nothing here is required. Kokoro runs on this Mac and needs no key.
# Copy to .env (here or in the folder above) to change a default.

# TTS_VOICE=af_heart          # voice preselected on first run; `python3 ../tts.py --list-voices` shows them all
# TTS_DEVICE=cpu              # auto (default: Apple GPU when available), mps or cpu
# TTS_PYTHON=/path/to/python  # a Python that has kokoro installed, instead of tts-studio/.venv
# PORT=8787                   # port for `npm start`
# TTS_DATA_DIR=/path/to/library   # where the database and MP3s are stored
# TTS_ENV_DIR=/path/to/folder     # read .env from another folder

# The "Explain it to me" panel asks Claude Code to write each lesson, unless Settings
# (the gear in the header) chooses another writer. Values set here win over Settings.
# TTS_CLAUDE_BIN=/path/to/claude  # the Claude Code command, if it is not on PATH
# TTS_CLAUDE_MODEL=opus           # model for writing lessons; default is Claude Code's own default
# TTS_CLAUDE_EFFORT=high         # effort for writing: low, medium, high (default), xhigh, max, or auto for Claude Code's own
# TTS_CLAUDE_FIX_EFFORT=low       # effort for fixing failing scenes (default low: a fix is mechanical)
# TTS_CLAUDE_POLISH_EFFORT=medium # effort for the round on timing and layout
# TTS_CLAUDE_READ_EFFORT=medium   # effort for writing out attached notes, when another writer reads them
# TTS_CLAUDE_OUTLINE_EFFORT=medium # effort for outlines of long lessons
# TTS_AUTHOR_MAX_COST_USD=15      # what one lesson may cost before it stops (Settings → Costs otherwise)
# TTS_CLAUDE_TIMEOUT_MIN=20       # minutes one request to Claude may take
# TTS_AUTHOR_FIXES=3              # how many times Claude may be asked to fix failing scenes
# TTS_AUTHOR_POLISH=0             # skip the extra round for timing and layout warnings
# TTS_AUTHOR_VISUAL_REVIEW=1      # show Claude the storyboard's stills in that round, for every lesson
# TTS_AUTHOR_PARALLEL=2           # lessons written at once; their checks still take turns
# TTS_LESSON_REVIEW=storyboard    # new lessons sent without a choice wait at their storyboard
# TTS_NOTES_IMAGE_EDGE=1400       # pixels on the long side of an attached photo
# TTS_KEEP_RENDERS=3              # videos kept per lesson, the current one included
# AUTHOR_PORT=8790                # port for the lesson writer
# TTS_AUTHOR_URL=http://127.0.0.1:8790   # use a lesson writer started elsewhere (npm run author)
# TTS_VIDEO_DIR=/path/to/video    # the folder holding build.py, check.py and projects/

# Keys for other writers. Settings → Lesson writer keeps them in the Keychain instead; these win.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# TTS_KEYCHAIN=0                  # keep keys saved in Settings in data/secrets.json, not the Keychain

# The MCP connector (npm run mcp, or http://localhost:8787/mcp).
# NARRATED_PROOFS_URL=http://127.0.0.1:8787   # where the stdio connector finds the dashboard
# TTS_MCP_AUTOSTART=1             # let the stdio connector start the dashboard

# Scenes run inside the macOS sandbox: no network, no writing outside their project's build/.
# These are read by build.py and check.py, so set them in the environment; they do not read .env.
# VIDEO_SANDBOX=0                 # turn the sandbox off
# VIDEO_SCENE_CACHE=/path         # the cache scenes share (default ~/Library/Caches/narrated-proofs-scenes)
# VIDEO_SCENE_TIMEOUT=2700        # seconds one scene's full render may take
