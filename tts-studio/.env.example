# Nothing here is required. Kokoro runs on this Mac and needs no key.
# Copy to .env (here or in the folder above) to change a default.

# TTS_VOICE=af_heart          # voice preselected on first run; `python3 ../tts.py --list-voices` shows them all
# TTS_DEVICE=cpu              # auto (default: Apple GPU when available), mps or cpu
# TTS_PYTHON=/path/to/python  # a Python that has kokoro installed, instead of tts-studio/.venv
# PORT=8787                   # port for `npm start`
# TTS_DATA_DIR=/path/to/library   # where the database and MP3s are stored
# TTS_ENV_DIR=/path/to/folder     # read .env from another folder

# The "Explain it to me" panel asks Claude Code to write each lesson.
# TTS_CLAUDE_BIN=/path/to/claude  # the Claude Code command, if it is not on PATH
# TTS_CLAUDE_MODEL=opus           # model for writing lessons; default is Claude Code's own default
# TTS_CLAUDE_EFFORT=high         # low, medium, high, xhigh or max; default is Claude Code's own default
# TTS_CLAUDE_TIMEOUT_MIN=20       # minutes one request to Claude may take
# TTS_AUTHOR_FIXES=3              # how many times Claude may be asked to fix failing scenes
# TTS_AUTHOR_POLISH=0             # skip the extra round for timing and layout warnings
# AUTHOR_PORT=8790                # port for the lesson writer
# TTS_AUTHOR_URL=http://127.0.0.1:8790   # use a lesson writer started elsewhere (npm run author)
# TTS_VIDEO_DIR=/path/to/video    # the folder holding build.py, check.py and projects/

# Scenes run inside the macOS sandbox: no network, no writing outside their project.
# VIDEO_SANDBOX=0                 # turn that off (set it in the environment; build.py does not read .env)
