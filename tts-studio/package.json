{
  "name": "tts-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local dashboard: drop a text script, get an MP3 from the Kokoro model running on your Mac, keep a searchable library.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "sh scripts/setup.sh",
    "setup:japanese": "sh scripts/setup.sh --japanese",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "author": "node author/index.js",
    "mcp": "node mcp/stdio.js",
    "mcp:pack": "node scripts/mcp-pack.js",
    "bakeoff": "node scripts/bakeoff.js",
    "app": "vite build && node server/index.js",
    "test": "npm run test:server && npm run test:client && npm run test:python",
    "test:server": "node --test server/test/*.test.js author/test/*.test.js mcp/test/*.test.js",
    "test:client": "vitest run",
    "test:python": "python3 -m unittest discover -s engine && python3 -m unittest discover -s ../video",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "openai": "^7.30.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "vite": "^6.4.3",
    "vitest": "^5.0.3"
  }
}
